# Required
FLARE_SOLVER_URL=http://localhost:8191
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin (optional — enables /stats command)
ADMIN_TELEGRAM_ID=

# Schedule (optional, default: every 30 min)
CRON_SCHEDULE=0 */5 * * *
SCRAPE_PAGES=1

# Filters (optional)
STORES=Steam, Ubisoft Store, Epic Games Store, Microsoft Store, PlayStation Store, Rockstar Store
MIN_DISCOUNT=0
MAX_PRICE=0
MIN_RATING=0
PLATFORMS=
FREE_ONLY=false
MIN_RATING_OVERRIDES=

# Batch mode (optional, default: one msg per deal)
SILENT_MODE=false
